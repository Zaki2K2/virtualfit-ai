# ---------- API (apps/api) ----------
NODE_ENV=development
API_PORT=5000
# Origin allowed to call the API directly (the web app normally proxies /api, so this is rarely needed)
WEB_ORIGIN=http://localhost:3000

# MongoDB is OPTIONAL. If unset, the API uses an in-memory store (data is lost on restart).
# MONGODB_URI=mongodb://127.0.0.1:27017/virtualfit

# Where uploaded/generated files live (relative to apps/api or absolute)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8
# Generated results are deleted after this many hours (privacy: avoid long-term storage)
RESULT_RETENTION_HOURS=24

# ---------- AI provider ----------
# mock   = local simulation, clearly watermarked, NOT real AI output (default)
# gradio = remote Hugging Face Space through @gradio/client (see docs/ai-integration.md)
# custom-python = our own Python engine (see ENGINE_* below)
AI_PROVIDER=mock
AI_TIMEOUT_MS=180000

# Local language-only styling assistant (separate from vision AI_PROVIDER).
# Run npm run slm:setup only if the model is missing, then npm run dev:ai.
# Existing npm run dev remains unchanged; standalone SLM: npm run slm:serve.
# Loopback only; no third-party language service or API key needed.
SLM_URL=http://127.0.0.1:8081
SLM_MODEL=virtualfit-style-base
# Optional custom runtime; kept unavailable until registration succeeds.
SLM_CUSTOM_URL=http://127.0.0.1:8082
SLM_TIMEOUT_MS=60000

# Real AI (free, noncommercial): uncomment these two lines, restart `npm run dev`.
# AI_PROVIDER=gradio
# GRADIO_PRESET=idm-vton
# Optional free Hugging Face read token for more GPU quota. Server side only - never in the web app.
# HF_TOKEN=hf_xxx

# Advanced: any of these override the preset (or configure a different Space).
# Take names/parameters from `npm run ai:inspect -- owner/space-name` - never guess them.
# GRADIO_SPACE_ID=owner/space-name
# GRADIO_API_NAME=/endpoint_name
# JSON (object = named params, array = positional); placeholders "{{person}}", "{{garment}}",
# "{{clothType}}" and "{{category}}" are substituted per request.
# GRADIO_PARAMS_TEMPLATE=
# Index of the output (in the Space's returned data array) that holds the result image
# GRADIO_OUTPUT_INDEX=0

# ---------- Python engine (ai-engine/, optional) ----------
# URL of the FastAPI service. Unset = the "pretrained" and "custom" models are unavailable.
# The engine is NOT started by `npm run dev`; it needs a CUDA GPU host (see ai-engine/README.md).
# ENGINE_URL=http://127.0.0.1:8000
# Must equal the engine's ENGINE_API_KEY. Server side only.
# ENGINE_API_KEY=change-me
# Default model when AI_PROVIDER=custom-python: pretrained | custom
# ENGINE_DEFAULT_MODEL=pretrained
# AI_PROVIDER also accepts: custom-python

# ---------- Web (apps/web) ----------
# Where the Next.js server proxies /api/* to
API_URL=http://localhost:5000
